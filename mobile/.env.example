# No VITE_ prefix — read server-side only, by netlify/functions/groq.js and
# api/groq.js, never bundled into client code.
GROQ_API_KEY=your_groq_api_key
# Optional — free fallback used automatically when Groq rate-limits (429).
NVIDIA_API_KEY=your_nvidia_build_api_key

# Optional — powers "Connect bank" in Statements (Plaid Link). Get these
# from https://dashboard.plaid.com. PLAID_ENV=sandbox uses fake test data
# (no real bank needed); PLAID_ENV=production is required to connect a
# real Chase account — free for personal use under Plaid's Trial plan
# (up to 10 connected accounts, no per-call charge on top of that).
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
