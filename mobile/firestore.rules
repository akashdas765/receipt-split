rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every user's data — profile doc (splitwise_api_key), their receipts
    // subcollection, their bank/manual transactions subcollection (the
    // Statements feature — bank statement data, more sensitive than
    // receipts, gets the same per-user isolation), and their Plaid bank
    // connections subcollection (access tokens — see
    // services/db.js's savePlaidConnection) — is only readable/writable by
    // that same authenticated user. See src/services/db.js and
    // src/services/auth.js for the exact paths this must match.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /receipts/{receiptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /plaidConnections/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /manualAccounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
